{
  "stryker-config": {
    "project": "QuerySpec.Core.csproj",
    "test-projects": [
      "tests/QuerySpec.Core.Tests/QuerySpec.Core.Tests.csproj"
    ],
    "target-framework": "net9.0",
    "configuration": "Release",
    "mutation-level": "Standard",
    "coverage-analysis": "all",
    "ignore-mutations": [
      "linq"
    ],
    "ignore-methods": [
      "RegisterUnrestricted",
      "EscapeSqlLiteral"
    ],
    "mutate": [
      "src/QuerySpec.Core/**/*.cs",
      "!src/QuerySpec.Core/Properties/**"
    ],
    "baseline": {
      "enabled": false,
      "provider": "Dashboard",
      "fallback-version": "develop"
    },
    "project-info": {
      "name": "github.com/AbongileBoja/QuerySpec",
      "module": "core"
    },
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "reporters": ["html", "progress", "json", "dashboard"]
  }
}

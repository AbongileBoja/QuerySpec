{
  "stryker-config": {
    "project": "QuerySpec.DependencyInjection.csproj",
    "test-projects": [
      "tests/QuerySpec.Core.Tests/QuerySpec.Core.Tests.csproj"
    ],
    "target-framework": "net9.0",
    "configuration": "Release",
    "mutation-level": "Standard",
    "coverage-analysis": "off",
    "ignore-mutations": [
      "linq"
    ],
    "mutate": [
      "src/QuerySpec.DependencyInjection/**/*.cs",
      "!src/QuerySpec.DependencyInjection/Properties/**"
    ],
    "baseline": {
      "enabled": false,
      "provider": "Dashboard",
      "fallback-version": "develop"
    },
    "project-info": {
      "name": "github.com/AbongileBoja/QuerySpec",
      "module": "di"
    },
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "reporters": ["html", "progress", "json", "dashboard"]
  }
}

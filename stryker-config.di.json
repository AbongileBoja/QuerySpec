{
  "stryker-config": {
    "project": "QuerySpec.DependencyInjection.csproj",
    "test-projects": [
      "tests/QuerySpec.Core.Tests/QuerySpec.Core.Tests.csproj"
    ],
    "target-framework": "net9.0",
    "configuration": "Release",
    "mutation-level": "Standard",
    "coverage-analysis": "perTest",
    "ignore-mutations": [
      "linq"
    ],
    "mutate": [
      "src/QuerySpec.DependencyInjection/**/*.cs",
      "!src/QuerySpec.DependencyInjection/Properties/**"
    ],
    "with-baseline": true,
    "since": {
      "target": "develop"
    },
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "reporters": [
      "html",
      "progress",
      "json",
      "dashboard"
    ],
    "dashboard": {
      "project": "github.com/AbongileBoja/QuerySpec",
      "version": "develop",
      "module": "di"
    }
  }
}

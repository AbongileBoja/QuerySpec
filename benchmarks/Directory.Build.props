<Project>
  <!--
    BenchmarkDotNet emits an auto-generated csproj under
    bin/Release/net10.0/{guid}/BenchmarkDotNet.Autogenerated.csproj. That child project
    walks up looking for Directory.Build.props and would otherwise inherit the repository
    root's multi-targeting (net8.0;net9.0;net10.0) while its referenced benchmarks
    assembly only builds for net10.0, causing NU1201.

    Pinning a single TFM here scopes both our benchmarks project and BDN's generated
    wrapper to net10.0.
  -->
  <Import Project="..\Directory.Build.props" />

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- BDN-generated code has missing docs; don't fail on them. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>

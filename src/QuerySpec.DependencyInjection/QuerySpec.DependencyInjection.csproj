<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Package-specific metadata -->
    <PackageId>QuerySpec.DependencyInjection</PackageId>
    <Title>QuerySpec Dependency Injection</Title>

{
  "stryker-config": {
    "test-projects": [
      "../../tests/QuerySpec.Core.Tests/QuerySpec.Core.Tests.csproj"
    ],
    "target-framework": "net9.0",
    "mutation-level": "Standard",
    "configuration": "Release",
    "coverage-analysis": "off",
    "ignore-mutations": [
      "linq"
    ],
    "ignore-methods": [
      "RegisterUnrestricted",
      "EscapeSqlLiteral"
    ],
    "mutate": [
      "Security/**/*.cs"
    ],
    "thresholds": {
      "high": 90,
      "low": 85,
      "break": 85
    },
    "reporters": [
      "html",
      "progress",
      "json"
    ]
  }
}

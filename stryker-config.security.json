{
  "stryker-config": {
    "project": "QuerySpec.Core.csproj",
    "test-projects": [
      "tests/QuerySpec.Core.Tests/QuerySpec.Core.Tests.csproj"
    ],
    "target-framework": "net9.0",
    "configuration": "Release",
    "mutation-level": "Standard",
    "coverage-analysis": "perTest",
    "ignore-mutations": [
      "linq"
    ],
    "ignore-methods": [
      "RegisterUnrestricted",
      "EscapeSqlLiteral"
    ],
    "mutate": [
      "src/QuerySpec.Core/Security/**/*.cs"
    ],
    "with-baseline": true,
    "since": {
      "target": "develop"
    },
    "thresholds": {
      "high": 90,
      "low": 85,
      "break": 0
    },
    "reporters": [
      "html",
      "progress",
      "json",
      "dashboard"
    ],
    "dashboard": {
      "project": "github.com/AbongileBoja/QuerySpec",
      "version": "develop",
      "module": "security"
    }
  }
}
